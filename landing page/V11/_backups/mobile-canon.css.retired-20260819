/* ============================================================================
   II 랜딩 — 모바일 캐논 (2026-08-17)
   전 페이지 공통. 각 페이지 인라인 <style id="v9-mobile"> **뒤에** 로드되어
   페이지별 잔재를 이긴다. 새 페이지는 이 파일을 링크만 하면 정렬된다.

   기준: 홈(index.html) + SD(self-directed.html) 에서 확정된 값.
   데스크탑(>900)에는 어떤 규칙도 없다 — 전부 @media 안.
   ========================================================================= */
@media (max-width:900px){

/* ── 1. 타이포 티어 ──────────────────────────────────────────────────────
   디스플레이 28클램프/1.1 · 스트림·시퀀스 24|22/1.15 · 항목 17/1.15
   프로즈 15/1.4 · small 13/1.4 · 모노 라벨 13/1.5 · 모노 meta 11/1.4 · 피겨 9/1.4 */
.hbar,.bigh2,.sys h2,.loop3 h2{font-size:clamp(28px,7.4vw,40px);line-height:1.1;letter-spacing:-0.02em}
.hero .hbar{line-height:1.5}                       /* 히로만 박스 티어 (배경 박스가 있는 경우) */
.v9band .v9ovl .bigh2 .a,.v9band .v9ovl .bigh2 .b{line-height:1.1}  /* 밴드 타이틀은 지면 = 박스 아님 */

/* ── 2. 시퀀스 레저 (01/02/03 번호 리스트) ───────────────────────────────
   .rows3(Managed·SD) · .lstrip(홈 NO.03) 동일 문법 */
.rows3,.loop3 .lstrip{display:block;overflow:visible;padding-top:0}
.rows3 .row,.loop3 .lstrip .step{position:relative;left:0;top:0;width:auto;margin:0;
  display:grid;grid-template-columns:48px 1fr;column-gap:16px;row-gap:0;
  padding:24px 0;border-top:0.667px solid rgba(28,28,28,0.16)}
.rows3 .row::before,.loop3 .lstrip .step::before{display:none}
.rows3 .row:last-child,.loop3 .lstrip .step:last-child{border-bottom:0}  /* 마지막 하단선 없음 */
.rows3 .row b,.loop3 .lstrip .step b{grid-column:1;grid-row:1;display:block;
  font-family:var(--mono);font-size:11px;line-height:1.5;letter-spacing:0.04em;color:var(--c-accent)}
.rows3 .row .t,.loop3 .lstrip .step .t{grid-column:2;grid-row:1;margin:0;
  font-size:24px;font-weight:500;line-height:1.15;letter-spacing:-0.02em}
.rows3 .row .d,.loop3 .lstrip .step .d{grid-column:2;margin:16px 0 0;
  font-size:13px;line-height:1.4;max-width:none}

/* ── 3. 스탯 블록 (Anduril) ──────────────────────────────────────────────
   .tri(SD·Managed) · .dstats(홈 NO.04) · .g2stat(홈 NO.02)
   큰 숫자 34/1.15 → 라벨 15/1.4 → 행 위 헤어라인. 점선 금지, 마지막 하단선 없음 */
.tri,.tri.one,.dstats{display:block;border:0;padding-bottom:0;row-gap:0}
.tri .cell,.dstats .cell{display:flex;flex-direction:column;gap:0;margin:0;padding:24px 0;
  border-top:0.667px solid rgba(255,255,255,0.18);border-bottom:0}
.tri .cell:last-child,.dstats .cell:last-child,.dstats .cell.gap{border-bottom:0}
.tri .cell .v,.dstats .cell .v{order:-1;text-align:left;margin:0;
  font-size:34px;font-weight:500;line-height:1.15;letter-spacing:-0.069em;color:var(--c-white)}
.tri .cell .v.gap,.dstats .gap .v{color:var(--c-urgent-muted)}
.tri .cell .t,.dstats .cell .t{margin:8px 0 0;max-width:none;
  font-family:var(--font);font-size:15px;font-weight:400;line-height:1.4;letter-spacing:0;color:var(--c-400)}
.tri .rule,.tri .cell .rule,.tri.one .cell .rule,.dstats .rule,.dstats .cell .rule,.g2stat .rule{display:none!important} /* 점선 룰 요소 폐기 - V8 이 .tri .cell .rule 3단으로 켜서 !important */
.g2stat .v{font-size:34px;line-height:1.15;letter-spacing:-0.069em}

/* ── 4. 카드 그룹 → 헤어라인 행 (.refuse) ────────────────────────────────
   박스는 앱 리플리카/도판에만 허용 (dr-doc · dr3-* · cal-card · loopfig · suit5) */
.refuse{border:0;background:none;display:block}
.bandimg .refuse{background:none}
.refuse .r{border:0;border-top:0.667px solid rgba(255,255,255,0.18);padding:24px 0}
.refuse .r:last-child{border-bottom:0}
.refuse .r b{display:block;margin-bottom:16px;
  font-size:22px;font-weight:500;line-height:1.15;letter-spacing:-0.02em;color:var(--c-white)}
.refuse .r p{font-size:15px;line-height:1.4;color:var(--c-400)}

/* ── 5. 항목 리스트 (계좌·포트폴리오·모드) ───────────────────────────────
   제목 22/1.15, 메타 8 아래, 본문 16 아래 */
.pflist .pfrow .n,#portfolios .pflist .pfrow .n,.acct3 .a h3,.sys .mode h3{font-size:22px!important;font-weight:500;line-height:1.15!important;letter-spacing:-0.02em}
.acct3 .a{padding:24px 0;gap:0;border-top:0.667px solid rgba(255,255,255,0.18)}
.acct3{border-bottom:0;padding-bottom:0;row-gap:0}
.acct3 .a .lim{font-size:11px;line-height:1.4}
.acct3 .a p{margin-top:16px;font-size:15px;line-height:1.4}

/* ── 6. 포토 밴드 ────────────────────────────────────────────────────────
   타이틀 = 지면 (박스 없음) → 이미지 = 단독 비트. 순서는 페이지 JS 가 래핑 */
.v9band{position:relative;display:flex;flex-direction:column-reverse}
.band>.v9band{position:relative;width:100%;margin:0;left:auto;top:auto}
.v9band>img,.v9band>video{display:block;width:100%;height:clamp(360px,82.5vw,510px);
  object-fit:cover;position:static;inset:auto;filter:none}
.v9band .v9ovl{position:static;margin:0;padding:104px 20px 40px}
.v9band .v9ovl>*{position:static;margin:0;width:auto;max-width:none}
.v9band .v9ovl>.bigh2,.v9band .v9ovl>.hbargrp,.v9band .v9ovl>.hbargrp5{margin-top:24px}
.v9band .v9ovl .bigh2 .a,.v9band .v9ovl .bigh2 .b,.v9band .v9ovl .hbar{
  display:block;background:none;padding:0;white-space:normal;
  font-size:clamp(28px,7.4vw,40px);line-height:1.1}

/* ── 7. 섹션 리듬 104/104 ────────────────────────────────────────────────
   밴드로 시작하는 섹션은 상단 0 (타이틀 블록이 104 를 담당) */
.secpad{padding:104px 0}
.bandimg,.def4,.std5,.gap2{padding-top:0}
.band>*:last-child{margin-bottom:0}

/* ── 8. 표 ───────────────────────────────────────────────────────────────
   가로 스크롤은 표에만 허용된 예외. 헤더 글자가 래퍼 위에 붙지 않게 16 */
.tbl thead th{padding-top:16px}

/* ── 9. 피겨 캡션 / 메타 ─────────────────────────────────────────────────*/
.figcap{font-size:9px;line-height:1.4}
.metaline{line-height:1.4}
.figcap+.figcap,.metaline+.metaline{margin-top:8px!important}

/* ── 10. 내브 (스크롤 다운 숨김 / 업 복귀 · GM 버거) ─────────────────────*/
.nav{transition:background .35s ease,transform .3s ease}
.nav.away{transform:translateY(-100%)}
.nav .burger{width:24px;height:7px;left:auto;right:20px}
.nav .burger span{width:24px;background:var(--c-400)}
.nav .burger span:first-child{top:0}
.nav .burger span:last-child{bottom:0}
.nav.scrolled .burger span{background:var(--c-800)}
body.menu-open .nav .burger span{background:var(--c-200)}

/* ── 11. 금지 ────────────────────────────────────────────────────────────
   가로 스와이프 (표 제외) · 점선 구분선 · 1.3 행간 잔재 */
.cstrip,.lstrip,.rows3{scroll-snap-type:none}
}
