<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Get the App · Intelligent Investing</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--c-black:#000;--c-1000:#1C1C1C;--c-900:#232627;--c-800:#565B5E;--c-700:#929292;--c-600:#A7A7A7;--c-400:#C7C7C7;--c-200:#E3E2E2;--c-white:#FFF; --frame: clamp(24px, 4vw, 48px); --maxw: 1680px; --gutter: clamp(16px, 1.5vw, 24px); --c-elev: #0A0A0A; --mono:'IBM Plex Mono',ui-monospace,monospace; --u: calc(100vw / 2545); --t-mono15: max(13px, calc(15 * var(--u))); --t-mono13: max(11px, calc(13 * var(--u))); --t-mono11: max(9px, calc(11 * var(--u))); /* floor raised 12->13 / 10->11 (2026-08-02): 15u is 8.5px at 1440, so below ~2205px the floor is what renders - the whole laptop range sat at 12/10, one step under the 13/11 canon and smaller than mobile. The 2545 Figma frame is untouched: 15u=15 and 12u=12 both beat the new floors. */ --t-body: max(15px, calc(22 * var(--u)));}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{background:var(--c-black);color:var(--c-600);font-family:'Inter',sans-serif;font-feature-settings:'tnum' 1,'lnum' 1,'ss01' 1;-webkit-font-smoothing:antialiased;font-weight:400;}
body{min-height:100vh;font-size:15px;line-height:1.4;/* was 1.55 - leaked into nav links, EN/FR and CTAs (2026-08-01) */background:linear-gradient(180deg,var(--c-elev) 0,var(--c-black) 560px);}body.menu-open{overflow:hidden;}
/* ---- nav: transparent over hero, white bar on scroll (ported from index-H) ---- */
.nav{position:fixed;inset:0 0 auto;z-index:100;height:calc(78 * var(--u));min-height:54px;background:transparent;display:flex;align-items:center;transition:background 0.35s ease}
.nav .burger{position:absolute;left:24px;width:26px;height:12px;background:none;border:0;cursor:pointer}
.nav .burger span{position:absolute;left:0;width:26px;height:1px;background:var(--c-white);transition:background 0.35s ease}
.nav .burger span:first-child{top:1px}.nav .burger span:last-child{bottom:1px}
.brand{position:absolute;left:50%;transform:translateX(-50%);text-align:center;color:var(--c-white);transition:color 0.35s ease}
.brand .wm{font-weight:600;font-size:clamp(13px,calc(18 * var(--u)),18px);letter-spacing:-0.02em;line-height:1.5}
.brand .wm .lt{font-weight:300}
.brand .tag{font-family:var(--mono);font-size:var(--t-mono11);letter-spacing:0.04em;color:var(--c-600);transition:color 0.35s ease}
.nav .ncta{position:absolute;right:calc(21.6 * var(--u));top:50%;transform:translateY(-50%);min-width:max(150px, calc(196 * var(--u)));padding:0 22px;height:calc(48 * var(--u));min-height:36px;border:1px solid var(--c-white);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:400;font-size:var(--t-mono15);letter-spacing:0.04em;color:var(--c-white);transition:border-color 0.35s ease,color 0.35s ease}
.nav.scrolled{background:rgba(255,255,255,0.95)}
.nav.scrolled .burger span{background:var(--c-black)}
.nav.scrolled .brand{color:var(--c-1000)}
.nav.scrolled .brand .tag{color:var(--c-800)}
.nav.scrolled .ncta{border-color:var(--c-black);color:var(--c-1000)}
/* ---- nav v2: logo left, centered menu, EN/FR + CTA right ---- */
.nav .logo{position:absolute;left:calc(40 * var(--u));top:50%;transform:translateY(-50%);height:calc(20 * var(--u));min-height:16px;width:auto;display:block}
.nav .logo svg{height:100%;width:auto;display:block}
.nav .logo path{fill:var(--c-white);transition:fill 0.35s ease}
.nav.scrolled .logo path{fill:var(--c-1000)}
.nav a{text-decoration:none}
.navmenu{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;gap:calc(40 * var(--u))}
.navmenu a{font-weight:400;font-size:max(14px, calc(15 * var(--u)));color:var(--c-600);transition:color 0.35s ease}
.navmenu a.on{color:var(--c-white)}
.nav.scrolled .navmenu a{color:var(--c-800)}
.nav.scrolled .navmenu a.on{color:var(--c-1000)}
.navright{position:absolute;right:calc(40 * var(--u));top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:calc(28 * var(--u))}
.navright .ncta{position:static;right:auto;top:auto;transform:none}
.nav .lang{display:flex;gap:calc(14 * var(--u));font-family:var(--mono);font-size:var(--t-mono13);letter-spacing:0.04em}
.nav .lang a{color:var(--c-600);transition:color 0.35s ease}
.nav .lang a.on{color:var(--c-white)}
.nav.scrolled .lang a{color:var(--c-800)}
.nav.scrolled .lang a.on{color:var(--c-1000)}

.navbar{position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;transition:background 0.3s ease,backdrop-filter 0.3s ease;}
.navbar.scrolled{background:rgba(0,0,0,0.7);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);}
.navbar-inner{display:flex;align-items:center;justify-content:space-between;padding:var(--frame);gap:32px;position:relative;}

.navbar-brand img{height:14px;width:auto;display:block;}
.nav-links{display:none;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);align-items:center;gap:24px;}
.nav-links a{color:var(--c-700);font-size:13px;text-decoration:none;transition:color 0.15s ease;}
.nav-links a:hover{color:var(--c-white);}
.nav-links a.active{color:var(--c-white);}
@media(min-width:1024px){.nav-links{display:inline-flex;}.hamburger{display:none;}}

.navbar-right{display:flex;align-items:center;gap:24px;}
.navbar-cta{display:none;color:var(--c-200);text-decoration:none;font-size:13px;border:0.5px solid rgba(255,255,255,0.18);padding:8px 16px;}
@media(min-width:1024px){.navbar-cta{display:inline-block;}}
.hamburger{position:relative;width:40px;height:18px;background:none;border:none;cursor:pointer;}
.hamburger span{position:absolute;left:0;width:40px;height:1px;background:var(--c-200);transition:all 0.35s cubic-bezier(0.4,0,0.2,1);}
.hamburger span:nth-child(1){top:4px;}.hamburger span:nth-child(2){top:13px;}
.hamburger.open span{width:44px;left:-2px;top:8.5px;}
.hamburger.open span:nth-child(1){transform:rotate(24deg);}
.hamburger.open span:nth-child(2){transform:rotate(-24deg);}
.menu-overlay{position:fixed;inset:0;background:var(--c-black);z-index:200;display:flex;flex-direction:column;opacity:0;pointer-events:none;transition:opacity 0.4s cubic-bezier(0.4,0,0.2,1);}
.menu-overlay.open{opacity:1;pointer-events:auto;}
.menu-top{display:flex;align-items:center;justify-content:space-between;padding:clamp(28px,4vw,56px) clamp(40px,6vw,80px);}
.menu-top .ml-logo img{height:13px;}
.menu-top .ml-close{background:none;border:none;color:var(--c-400);font-size:13px;letter-spacing:0.04em;cursor:pointer;padding:8px;}
.menu-top .ml-close:hover{color:var(--c-white);}
.menu-center{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(20px,2vw,32px);}
.menu-center a{color:var(--c-400);text-decoration:none;font-size:clamp(32px,5vw,56px);letter-spacing:-0.02em;line-height:1.05;opacity:0;transform:translateY(20px);transition:all 0.4s ease;}
.menu-overlay.open .menu-center a{opacity:1;transform:translateY(0);}
.menu-overlay.open .menu-center a:nth-child(1){transition-delay:0.15s;}.menu-overlay.open .menu-center a:nth-child(2){transition-delay:0.20s;}.menu-overlay.open .menu-center a:nth-child(3){transition-delay:0.25s;}.menu-overlay.open .menu-center a:nth-child(4){transition-delay:0.30s;}.menu-overlay.open .menu-center a:nth-child(5){transition-delay:0.35s;}.menu-overlay.open .menu-center a:nth-child(6){transition-delay:0.40s;}
.menu-center a:hover{color:var(--c-white);}
.menu-bottom{display:grid;grid-template-columns:1fr 1fr;align-items:end;padding:clamp(28px,4vw,56px) clamp(40px,6vw,80px);gap:24px;font-size:11px;color:var(--c-700);}
.menu-bottom .mb-left{display:flex;flex-direction:column;gap:4px;}.menu-bottom .mb-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;}
.container { width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 var(--frame); box-sizing: border-box; }
/* ---- burger + menu overlay (mobile), ported from the other pages ---- */
.nav .burger{display:none;position:absolute;right:20px;left:auto;top:50%;transform:translateY(-50%);width:26px;height:12px;background:none;border:0;cursor:pointer;z-index:101}
.menuov{position:fixed;inset:0;z-index:90;background:var(--c-black);display:flex;flex-direction:column;justify-content:center;opacity:0;visibility:hidden;transition:opacity 0.35s ease,visibility 0.35s ease}
.menuov.open{opacity:1;visibility:visible}
.menuov .mlist{display:flex;flex-direction:column;gap:calc(28 * var(--u));padding-left:max(24px, calc(450 * var(--u)))}
.menuov a{font-weight:500;font-size:clamp(32px, calc(96 * var(--u)), 96px);line-height:1.05;letter-spacing:-0.02em;color:var(--c-700);text-decoration:none;transition:color 0.35s ease;width:fit-content}
.menuov a.cur,.menuov a:hover{color:var(--c-white)}
.menuov .mfoot{position:absolute;left:max(24px, calc(450 * var(--u)));bottom:calc(60 * var(--u));font-family:var(--mono);font-size:var(--t-mono13);letter-spacing:0.04em;color:var(--c-600)}
body.menu-open .nav .burger span{background:var(--c-white)}
body.menu-open .nav .burger span:first-child{top:50%;transform:translateY(-50%) rotate(45deg)}
body.menu-open .nav .burger span:last-child{bottom:auto;top:50%;transform:translateY(-50%) rotate(-45deg)}
body.menu-open .nav{background:transparent} /* the overlay is full-screen black - the bar must not keep its scrolled white ground. Was only on home/SD/Managed (2026-08-02) */
body.menu-open .nav .logo path{fill:var(--c-white)}
body.menu-open .nav .ncta{border-color:var(--c-white);color:var(--c-white)} /* these two were missing entirely here (2026-08-02) */
.lang-toggle{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-feature-settings:'tnum' 1;}
.lang-toggle .lt{color:var(--c-700);text-decoration:none;cursor:pointer;transition:color 0.15s ease;}
.lang-toggle .lt.active{color:var(--c-200);}
.lang-toggle .lt:hover{color:var(--c-white);}
.lang-toggle .sep{color:var(--c-800);}
.gta-section{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:140px var(--frame) 80px;max-width:var(--maxw);margin:0 auto;text-align:center;}
.gta-eyebrow{font-family:var(--mono);font-size:var(--t-mono13);color:var(--c-700);letter-spacing:0.04em;margin-bottom:36px;}
.gta-eyebrow .gta-wordmark{display:block;margin:0 auto;height:max(12px, calc(15 * var(--u)));width:auto;color:inherit}
.gta-title{font-size:calc(64 * var(--u));line-height:1.05;letter-spacing:-0.02em;color:var(--c-200);font-weight:400;margin-bottom:32px;text-wrap:balance;}
.gta-deck{font-size:var(--t-body);line-height:1.3;letter-spacing:0;color:var(--c-200);max-width:calc((100% + var(--gutter)) / 12 * 6 - var(--gutter));margin-bottom:24px;text-wrap:pretty;}
@media(max-width:760px){.gta-deck{max-width:none;}}
@media(max-width:640px){.gta-title{text-wrap:wrap;}}
.gta-actions{display:flex;gap:32px;align-items:stretch;flex-wrap:wrap;justify-content:center;margin-bottom:64px;}
.gta-store{display:inline-flex;align-items:center;text-decoration:none;transition:opacity 0.15s ease;border:0.5px solid rgba(255,255,255,0.18);padding:14px 22px;}
.gta-store:hover{opacity:0.85;}
.gta-badge{height:53px;width:auto;display:block;}
.gta-sign-in{margin-top:48px;padding-top:48px;border-top:0.5px solid rgba(255,255,255,0.18);max-width:480px;width:100%;}
.gta-sign-in-lbl{font-size:13px;line-height:1.3;color:var(--c-700);margin-bottom:16px;} /* small-copy tier - was inheriting body 1.55 (type audit 2026-07-31) */
.cta-button{display:inline-flex;align-items:center;gap:calc(6 * var(--u));font-family:var(--mono);font-size:var(--t-mono15);letter-spacing:0.04em;color:var(--c-white);text-decoration:none;}
.cta-button .arr{display:inline-flex;align-items:center;line-height:1;}
.cta-button .arr-svg{width:13px;height:13px;display:block;}
.cta-button .roll{display:inline-block;overflow:hidden;vertical-align:bottom;height:1lh;}
.cta-button .roll-in{display:block;}
.cta-button .roll-in>span{display:block;}
@media (prefers-reduced-motion: no-preference){.cta-button .roll-in{transition:transform 0.55s cubic-bezier(0.16,1,0.3,1);}.cta-button:hover .roll-in{transform:translateY(-50%);}}
.gta-note{margin-bottom:64px;font-size:13px;color:var(--c-700);max-width:500px;line-height:1.3;} /* small-copy tier, desktop 1.3 - mobile override keeps 1.4 (type audit 2026-07-31) */
footer{border-top:0.5px solid rgba(255,255,255,0.18);padding:64px 0 36px;font-size:11px;line-height:1.5;color:var(--c-800);}.footer-copy{font-size:13px;color:var(--c-600);}
.footer-copy a{color:var(--c-600);text-decoration:underline;}
.footer-social{display:flex;gap:18px;margin-top:22px;}
.footer-social a{color:var(--c-700);display:inline-flex;transition:color 0.15s ease;}
.footer-social a:hover{color:var(--c-200);}
.footer-social svg{width:18px;height:18px;}
.footer-legal{font-size:11px;color:var(--c-700);line-height:1.5;margin-top:16px;} /* c-800 on black was 3.05:1 (WCAG AA fail). c-700 = 6.75:1, the exact colour the live footer uses (2026-08-02) */
.footer-legal:first-of-type{margin-top:36px;}
.footer-legal a{color:var(--c-700);text-decoration:underline;}
.footer-links{display:flex;flex-wrap:wrap;gap:18px;margin-bottom:22px;font-size:11px;line-height:1.4}
.footer-links a{color:var(--c-700);text-decoration:underline;position:relative}
.footer-links a:hover{color:var(--c-200)}
.footer-links a::after{content:'';position:absolute;inset:-16px 0} /* live-footer legal nav, added with the approved wording (2026-08-02) */
.footer-reset{display:inline-block;font-size:11px;color:var(--c-700);text-decoration:underline;margin-top:32px;}
@media (prefers-reduced-motion: no-preference){.ri{opacity:0;transform:translateY(24px);transition:opacity 0.7s cubic-bezier(0.2,0.6,0.2,1),transform 0.7s cubic-bezier(0.2,0.6,0.2,1);transition-delay:var(--d,0s);}.ri.in{opacity:1;transform:none;}}

/* ---- leading canon, same two values as the other pages (2026-08-01): 1.5 label + CTA, 1.4 meta ---- */
.gta-eyebrow,.cta-button,.nav .ncta,.nav .lang a,.navmenu a,.navbar-cta,.gta-store,
.menuov .menuov-cta,.menuov .mlang a{line-height:1.5}
.gta-note,.gta-sign-in,.footer-legal,.footer-reset,.footer-copy,.menuov .mfoot,.menuov .mfoot span{line-height:1.4}

@media(max-width:900px){
  html,body{max-width:100%;overflow-x:hidden;}
  .container{width:calc(100% - 40px);margin:0 auto;padding:0;}
  /* the CTA returns once the nav turns opaque on scroll (same as index-H) */
  .navmenu,.nav .lang{display:none}
  .navright{position:absolute;right:60px;top:50%;transform:translateY(-50%);display:flex;align-items:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .35s ease,visibility .35s ease}
  .navright .lang{display:none}
  .nav.scrolled .navright{opacity:1;visibility:visible;pointer-events:auto}
  /* .nav.scrolled .navright (3 classes) outranked a 2-class selector, so the nav CTA stayed
     visible behind the open menu and the overlay's own CTA - two Open an Account buttons. */
  body.menu-open .nav.scrolled .navright,body.menu-open .navright{opacity:0;visibility:hidden;pointer-events:none}
  .nav .burger{display:block}
  /* rotating the 26px bars into an X shrinks their ink to 18.4px, pulling the right edge 3.8px inward. Nudge out so the X ink lands on the same 20px gutter as the logo. */
  body.menu-open .nav .burger{right:16.2px}
  .nav .logo{left:20px}
  /* nav-only compact CTA + tap targets (2026-08-01): ink unchanged, hit boxes grown to 44 */
  .nav .ncta{min-width:0;padding:0 12px;height:32px;min-height:32px;white-space:nowrap;font-size:11px}
  .navright .ncta{position:relative}
  .nav .ncta::after{content:'';position:absolute;inset:-6px}
  .nav .burger::after{content:'';position:absolute;inset:-16px -9px}
  .nav .logo::after{content:'';position:absolute;inset:-14px}
  .cta-button,.gta-store,.gta-sign-in a,footer a,.footer-reset{position:relative}
  .cta-button::after,.gta-sign-in a::after{content:'';position:absolute;inset:-12px 0}
  footer a::after,.footer-reset::after{content:'';position:absolute;inset:-16px 0}
  .footer-social a{position:relative}
  .footer-social a::after{content:'';position:absolute;inset:-13px} /* 18 + 26 = 44 square; overrides the footer a::after catch-all, which only grew height (2026-08-02) */
  .menuov .mlist a,.menuov .mlist2 a,.menuov .mlang a{position:relative}
  .menuov .mlist a::after,.menuov .mlist2 a::after{content:'';position:absolute;inset:-10px 0}
  .menuov .mlang a::after{content:'';position:absolute;inset:-16px -8px}
  .heyeb-sep{display:none}.heyeb-b{display:block}
  .menuov .mlist{padding-left:20px}
  .menuov a{font-size:27px} /* 32 is off-scale and out-shouted the 27 masthead at the same 500 weight */
  .menuov .mfoot{left:20px;right:20px;bottom:20px}
  .menuov .mlang{margin:24px 0 0 20px;display:flex;gap:16px;font-family:var(--mono);font-size:13px;letter-spacing:0.04em}
  .menuov .mlang a{font-size:13px;font-weight:400;color:var(--c-600);letter-spacing:0.04em}
  .menuov .mlang a.on{color:var(--c-white)}
  .gta-section{padding:120px 20px 72px}
  .gta-eyebrow{font-size:13px;color:var(--c-600);margin-bottom:24px}
  .gta-title{font-size:clamp(26px,6.92vw,40px);line-height:1.1;margin-bottom:24px}
  .gta-deck{max-width:none;font-size:15px;line-height:1.4;margin-bottom:16px}
  .gta-note{font-size:13px;line-height:1.4;max-width:none;margin-bottom:48px}
  .gta-sign-in-lbl{line-height:1.4} /* mobile small-copy tier (type audit 2026-07-31) */
  .gta-actions{gap:24px;margin-bottom:0}
  .gta-badge{height:44px}
  .gta-sign-in{margin-top:48px;padding-top:48px}
  .cta-button{font-size:13px}

  /* ================= mobile typography + spacing canon (2026-07-28) =================
     Ported from index-H after the section-by-section audit. Single source: Doctrine/Typography.md
     leading: 27 -> 1.1 | 22/17 -> 1.15 | prose 15/13 -> 1.4 | mono -> 1.5 | .hbar box -> 1.5
     mono:    13 section label + CTA | 11 meta/date/notice | 9 figure + data meta (12 retired)   */
  h2,.bigh2,.mast+h2{line-height:1.1}
  .streamhd,.qh2{line-height:1.15}
  p,li,.body,.lead,.prose p{line-height:1.4}
  .figcap,.src,.metaline,.trust .ti span,.trust9 .ti span{line-height:1.5}
  .eyeb,.eyebrow,.eyebrow5,.qcap5,.mast,.heyeb{line-height:1.5}
  .mlink,.mlink span,.cta-fill,.lnk{line-height:1.5}
  section.band .eyeb,section.band .eyebrow,section.band .eyebrow5,
  section.band .qcap5,section.band .mast,.hero .heyeb,
  .page-header .eyeb,.pr-eyeb,.cl-eyeb{font-size:13px}
  .figcap,.src{font-size:9px;letter-spacing:0.04em}
  .hero .htrust,.metaline,.legal,.foot9,.foot9 span{font-size:11px}}
</style>
<!-- mobile-canon.css (2026-08-17) 링크를 뺐다 — _backups/ 로 아카이브됨.
     그 파일도 공유 모바일 레이어를 노렸지만 홈·SD·Managed 가 링크하지 않았고,
     이 페이지들에는 그 파일이 겨냥한 컴포넌트가 거의 없었다. 실측 결과 6페이지
     전체에서 바꾸는 값이 2개뿐이었고(버거 메뉴 선 색) 그 규칙은 shared/v11.css
     4l-2 로 옮겼다. 이제 9페이지 전부가 같은 파일 하나를 본다. -->
</head>
<body class="p-doc">
<nav class="nav">
  <a class="logo" href="index.html" aria-label="Home"><svg viewBox="0 0 15 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.59903 0H7.79315L2.19412 17.6523H0L5.59903 0Z"/><path d="M12.8061 0H15.0002L9.40115 17.6523H7.20703L12.8061 0Z"/></svg></a>
  <div class="navmenu">
    <a href="index.html">Home</a>
    <a href="self-directed.html">Self-Directed</a>
    <a href="managed.html">Managed</a>
    <a href="pricing.html">Pricing</a>
    <a href="manifesto.html">Manifesto</a>
  </div>
