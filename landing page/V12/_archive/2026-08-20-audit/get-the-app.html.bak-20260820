<script>
const hamburger=document.querySelector('.hamburger');const menuOverlay=document.querySelector('.menu-overlay');const menuClose=document.querySelector('.ml-close');const body=document.body;
if(hamburger&&menuOverlay){
function openMenu(){menuOverlay.classList.add('open');hamburger.classList.add('open');body.classList.add('menu-open');}
function closeMenu(){menuOverlay.classList.remove('open');hamburger.classList.remove('open');body.classList.remove('menu-open');}
hamburger.addEventListener('click',e=>{e.stopPropagation();menuOverlay.classList.contains('open')?closeMenu():openMenu();});
  menuClose&&menuClose.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menuOverlay.classList.contains('open')) closeMenu(); });
}
</script>

<script>if('IntersectionObserver' in window){var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -6% 0px'});document.querySelectorAll('.ri').forEach(function(el){rio.observe(el);});}else{document.querySelectorAll('.ri').forEach(function(el){el.classList.add('in');});}</script>
<script>(function(){var nav=document.querySelector('.nav');if(!nav)return;function onScroll(){nav.classList.toggle('scrolled',window.scrollY>24);}window.addEventListener('scroll',onScroll,{passive:true});onScroll();})();</script>
<script>(function(){var burger=document.querySelector('.nav .burger');var ov=document.getElementById('menuov');if(!burger||!ov)return;function toggle(){var open=document.body.classList.toggle('menu-open');ov.classList.toggle('open',open);ov.setAttribute('aria-hidden',String(!open));burger.setAttribute('aria-expanded',String(open));}burger.addEventListener('click',toggle);document.addEventListener('keydown',function(e){if(e.key==='Escape'&&document.body.classList.contains('menu-open'))toggle();});})();</script>
<script src="grid-overlay.js"></script>

<style id="v9-mobile">
/* ============ V10 mobile layer - Get the App (2026-08-16).
   Carries exactly ONE rule, added 2026-08-16 after the burger/logo review. Everything else about
   this page was audited and needed nothing (see the note below). ============ */
@media (max-width:900px){
  /* ---- burger vs logo (2026-08-16, Inkyung) ----
     Logo = two thin diagonal strokes, burger = two thin horizontal strokes; on a dark ground they
     read as a mirrored pair. This page still had the burger at c-white, identical to the logo.
     All four dark-ground pages (home / SD / Managed / here) now sit at c-600, two steps below the
     white logo. The cream pages carry an ink burger and are untouched. */
  .nav .burger span{background:var(--c-600)}
  /* burger geometry unified to the home/SD value (2026-08-16, Inkyung). V8 shipped 26x12 with an
     8px gap; home/SD were tightened to 24x7 / 5px during the V9 build and the rest were never
     brought along. Narrow wins. The 44px hit box is unaffected - it comes from
     .nav .burger::after{inset:-16px -9px}, not from the icon box. */
  .nav .burger{width:24px;height:7px}
  .nav .burger span{width:24px}
  .nav .burger span:first-child{top:0}
  .nav .burger span:last-child{bottom:0}

  /* type sweep (2026-08-16, Inkyung: 전 페이지 행간·자간 통일):
     - display clamp raised to the DS v16 canon 28/7.4vw (= 29 at 390); was the stale 26/6.92vw
     - weight 400 -> 500: every other hero on the site is 500 and the DS puts 24u+ at 500.
       ⚠ Desktop .gta-title still declares 400 (V8 verbatim, untouched) - flag for the desktop
       sweep rather than a silent mobile/desktop split... which this rule now creates on purpose,
       mobile-first. */
  .gta-title{font-size:clamp(28px,7.4vw,40px);letter-spacing:-0.02em;font-weight:500}
}

/* ============ The rest of this page: DELIBERATELY UNTOUCHED.
   Desktop is V8 verbatim; the mobile block above is left exactly as it was.

   Do not "finish" this page by adding rules - it was audited on 2026-08-16 and had nothing to fix:

   - ONE section, full viewport (.gta-section is min-height:100vh, flex, vertically centred).
     Measured at 375: section height 812 = viewport 812, content 442 words, no scroll.
   - No photo bands, no stat blocks, no tables, no horizontal strips, no dtonly cuts.
     Content parity is whole (the only hidden nodes are .navmenu and .lang, both in the burger).
   - Type and spacing already sit on the ladder: eyebrow 13 mono, title clamp(26,6.92vw,40),
     deck 15/1.4, note 13/1.4, sign-in rule margin 48 + padding 48.

   ★ The 104 section rhythm is NOT applied here, and that is intentional.
     .gta-section keeps padding:120px 20px 72px. On the other eight pages 104 expresses the gap
     BETWEEN stacked sections. This page has no second section - the padding is just screen
     clearance around vertically-centred content, so raising it to 104 would only squeeze the
     centred block. Same reasoning as the 120 hero tops elsewhere (nav clearance, not rhythm).
   ============ */
</style>
<!-- THE SHARED LAYER. Loads last so it wins on source order at equal specificity.
     Every rule that must be identical on every V11 page lives in this one file.
     This page has no hero, no close block and no trust fold, so what it takes from
     the shared layer is: the burger-menu tier, the footer boundary and hairline,
     the inline-link underline, and the desktop type floors.
     No body class is needed - body.p-sub only switches on the band hero.
     Verify with:  python shared/check-v11.py                See shared/v11.css -->
<link rel="stylesheet" href="shared/v11.css">



<!-- THE SHARED SCRIPT LAYER. On this page only the footer builder does anything -
     it wraps the legal paragraphs so they can run in two columns on desktop.
     The hero, trust and reveal parts find nothing and bail. See shared/v11-sub.js. -->
<script src="shared/v11-sub.js"></script>
